<section class="container-shell py-section">
  <h2 class="section-title">{{ section.settings.heading }}</h2>
  <p class="section-subtitle">{{ section.settings.subheading }}</p>
  <div class="grid grid--three mt-6">
    {% for block in section.blocks %}
      <div class="card-surface" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name":"Trust modules",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Trust & Quality Modules"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Placeholder trust statements ready for verified compliance updates."}
  ],
  "blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Quality checked workflows"}]}],
  "max_blocks": 6,
  "presets":[{"name":"Trust modules","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
