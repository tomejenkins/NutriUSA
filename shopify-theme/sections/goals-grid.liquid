<section class="container-shell py-section">
  <h2 class="section-title">{{ section.settings.heading }}</h2>
  <div class="grid grid--four mt-6">
    {% for block in section.blocks %}
      <div class="card-surface text-sm text-navy" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Goals grid",
  "settings": [{"type":"text","id":"heading","label":"Heading","default":"Shop by Goal"}],
  "blocks": [{"type":"goal","name":"Goal","settings":[{"type":"text","id":"text","label":"Text","default":"Energy & Performance"}]}],
  "max_blocks": 12,
  "presets": [{"name":"Goals grid","blocks":[{"type":"goal"},{"type":"goal"},{"type":"goal"},{"type":"goal"},{"type":"goal"},{"type":"goal"},{"type":"goal"},{"type":"goal"}]}]
}
{% endschema %}
