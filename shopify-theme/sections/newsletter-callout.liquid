<section class="container-shell py-section">
  <div class="newsletter-callout">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="Email address" required>
      <button type="submit" class="btn btn--premium">{{ section.settings.button_label }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name":"Newsletter callout",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Newsletter"},
    {"type":"textarea","id":"body","label":"Body","default":"Receive product launches, educational content, and seasonal offers."},
    {"type":"text","id":"button_label","label":"Button label","default":"Subscribe"}
  ],
  "presets":[{"name":"Newsletter callout"}]
}
{% endschema %}
