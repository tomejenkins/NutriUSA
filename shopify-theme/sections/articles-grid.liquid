<section class="container-shell py-section">
  <h2 class="section-title">{{ section.settings.heading }}</h2>
  {% assign blog_handle = section.settings.blog %}
  {% assign blog_obj = blogs[blog_handle] %}
  <div class="grid grid--two mt-6">
    {% if blog_obj != blank %}
      {% for article in blog_obj.articles limit: section.settings.limit %}
        <article class="card-surface">
          <p class="text-xs text-slatewarm">{{ article.tags.first | default: 'Education' }}</p>
          <h3 class="text-xl">{{ article.title }}</h3>
          <p class="text-sm">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          <a href="{{ article.url }}" class="btn btn--ghost">Read article →</a>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name":"Articles grid",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Educational Articles"},
    {"type":"blog","id":"blog","label":"Blog"},
    {"type":"range","id":"limit","min":2,"max":8,"step":1,"default":2,"label":"Articles"}
  ],
  "presets":[{"name":"Articles grid"}]
}
{% endschema %}
