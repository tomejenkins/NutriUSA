<section class="container-shell py-section">
  <h1 class="section-title">{{ collection.title }}</h1>
  {% if collection.description != blank %}<div class="section-subtitle rte">{{ collection.description }}</div>{% endif %}

  {% paginate collection.products by 24 %}
    <div class="grid grid--four mt-6">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="pagination" aria-label="Pagination">
        {{ paginate | default_pagination }}
      </nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{"name":"Collection template","settings":[]}
{% endschema %}
